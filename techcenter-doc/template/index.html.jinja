<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <link rel="stylesheet" href="./.__ontobdc__/asset/infobim-view/css/project_dashboard.css">
  <style>
    .view-topbar,
    .view-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .view-topbar-primary {
      grid-column: span 8;
      min-width: 0;
    }

    .view-hero-meta {
      grid-column: span 4;
      align-self: stretch;
      min-width: 0;
    }

    .view-column-third {
      grid-column: span 4;
    }

    .view-column-main {
      grid-column: span 8;
    }

    .view-topbar > *,
    .view-grid > *,
    .view-brand-copy,
    .metadata-row > * {
      min-width: 0;
    }

    .view-topbar h1,
    .view-eyebrow-meta,
    .metadata-row dd {
      overflow-wrap: anywhere;
    }

    .view-menubar-track {
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .menubar-item {
      flex: 0 0 auto;
      appearance: none;
      color: inherit;
      font: inherit;
      cursor: pointer;
    }

    .view-badge[data-card="numeric-data-card"] {
      grid-template-rows: auto auto 1fr;
      align-content: stretch;
    }

    .view-badge[data-card="numeric-data-card"] .view-badge-value {
      align-self: start;
      justify-self: center;
      max-width: 100%;
      margin: 14px 0 0;
      text-align: center;
      white-space: nowrap;
      word-break: normal;
      overflow-wrap: normal;
      font-size: clamp(2.5rem, 3.25vw, 3.75rem);
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .runtime-footer {
      display: grid;
      grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      margin-top: 24px;
    }

    .runtime-footer .view-panel-head,
    .runtime-footer .view-panel-body {
      padding-block: 14px;
    }

    .runtime-footer .view-panel-body {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 18px;
    }

    .runtime-footer .runtime-console {
      min-height: 0;
      margin: 0;
      padding: 10px 12px;
    }

    .project-tabs-card {
      min-height: 720px;
    }

    .project-tabs-shell {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      min-height: 620px;
    }

    .project-tabs-nav {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      padding: 12px 18px 0;
      overflow-x: auto;
      border-bottom: 1px solid var(--line);
      scrollbar-width: thin;
    }

    .project-tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      flex: 0 0 auto;
      appearance: none;
      min-height: 48px;
      padding: 10px 14px 13px;
      border: 0;
      border-radius: 14px 14px 0 0;
      color: var(--text-soft);
      background: transparent;
      font: inherit;
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      transition:
        color 160ms ease,
        background 160ms ease;
    }

    .project-tab::after {
      content: "";
      position: absolute;
      right: 10px;
      bottom: -1px;
      left: 10px;
      height: 2px;
      border-radius: 999px;
      background: transparent;
    }

    .project-tab:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.03);
    }

    .project-tab:focus-visible {
      outline: 2px solid var(--accent-strong);
      outline-offset: -2px;
    }

    .project-tab[aria-selected="true"] {
      color: var(--accent);
      background: rgba(103, 232, 249, 0.08);
    }

    .project-tab[aria-selected="true"]::after {
      background: linear-gradient(90deg, var(--accent), var(--accent-strong));
    }

    .project-tab-icon {
      font-size: 1rem;
      line-height: 1;
    }

    .project-tabs-content {
      min-width: 0;
      min-height: 0;
    }

    .project-tab-panel {
      min-height: 540px;
      padding: 28px;
    }

    .project-tab-panel[hidden] {
      display: none;
    }

    .project-tab-empty {
      display: grid;
      align-content: center;
      justify-items: center;
      min-height: 470px;
      padding: 36px;
      border: 1px dashed rgba(103, 232, 249, 0.22);
      border-radius: 22px;
      background:
        radial-gradient(circle at center, rgba(103, 232, 249, 0.07), transparent 62%),
        rgba(255, 255, 255, 0.018);
      text-align: center;
    }

    .project-tab-empty-icon {
      display: grid;
      place-items: center;
      width: 68px;
      height: 68px;
      margin-bottom: 18px;
      border: 1px solid rgba(103, 232, 249, 0.22);
      border-radius: 20px;
      color: var(--accent);
      background: rgba(103, 232, 249, 0.08);
      font-size: 1.8rem;
    }

    .project-tab-empty h3 {
      margin: 0;
      color: var(--text);
      font-size: clamp(1.35rem, 2vw, 1.8rem);
    }

    .project-tab-empty p {
      max-width: 58ch;
      margin: 10px 0 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    @media (max-width: 1200px) {
      .view-hero-meta {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .view-column-third,
      .view-column-main {
        grid-column: span 6;
      }

      .view-topbar h1 {
        font-size: clamp(2.45rem, 5vw, 4.2rem);
      }
    }

    @media (max-width: 1050px) {
      .view-topbar-primary,
      .view-hero-meta,
      .view-column-third,
      .view-column-main {
        grid-column: 1 / -1;
      }

      .view-hero-meta {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .metadata-row {
        grid-template-columns: minmax(92px, 0.35fr) minmax(0, 1fr);
      }

      .runtime-footer {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .view-hero-meta {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .view-brand {
        align-items: flex-start;
      }

      .view-topbar h1 {
        font-size: clamp(2.15rem, 10vw, 3.4rem);
        line-height: 0.98;
      }

      .metadata-row {
        grid-template-columns: 1fr;
        gap: 7px;
      }

      .runtime-console {
        max-width: 100%;
        overflow-x: auto;
      }

      .project-tabs-card,
      .project-tabs-shell {
        min-height: 0;
      }

      .project-tab-panel {
        min-height: 430px;
        padding: 18px;
      }

      .project-tab-empty {
        min-height: 390px;
        padding: 24px;
      }
    }

    @media (max-width: 480px) {
      .view-shell {
        padding: 12px;
      }

      .view-topbar,
      .view-grid,
      .view-column {
        gap: 12px;
      }

      .view-hero-card,
      .view-panel,
      .view-hero-meta {
        border-radius: 20px;
      }

      .view-hero-card {
        padding: 18px;
      }

      .view-brand {
        gap: 12px;
      }

      .view-brand-logo {
        width: 64px;
        height: 64px;
        flex: 0 0 64px;
      }

      .view-eyebrow {
        padding: 8px 10px;
        font-size: 0.68rem;
      }

      .view-eyebrow-meta {
        font-size: 0.68rem;
      }

      .view-topbar h1 {
        margin-top: 14px;
        font-size: clamp(1.9rem, 11vw, 2.7rem);
      }

      .view-menubar-card {
        padding: 5px 8px;
        border-radius: 18px;
      }

      .view-hero-meta {
        grid-template-columns: 1fr;
        padding: 14px;
      }

      .view-badge {
        aspect-ratio: auto;
        min-height: 128px;
      }

      .view-panel-head,
      .view-panel-body {
        padding-inline: 16px;
      }

      .runtime-footer .view-panel-body {
        grid-template-columns: 1fr;
      }

      .runtime-status {
        align-items: flex-start;
      }

      .runtime-console {
        padding: 12px;
        font-size: 0.76rem;
      }

      .project-tabs-nav {
        padding-inline: 10px;
      }

      .project-tab {
        min-height: 44px;
        padding-inline: 11px;
        font-size: 0.8rem;
      }

      .project-tab-panel {
        min-height: 360px;
        padding: 12px;
      }

      .project-tab-empty {
        min-height: 336px;
        padding: 20px;
        border-radius: 18px;
      }
    }
  </style>
</head>
<body>
  <main class="view-shell">
    <section class="view-topbar">
      <div class="view-topbar-primary">
        <article class="view-hero-card" data-card="hero-card">
          <div class="view-brand">
            <img class="view-brand-logo" src="./.__ontobdc__/asset/infobim-view/logo.png" alt="{{ brand.logo_alt }}">
            <div class="view-brand-copy">
              <span class="view-eyebrow">{{ brand.label }}</span>
              <span class="view-eyebrow-meta">{{ project.id }}</span>
            </div>
          </div>
          <h1>{{ project.name }}</h1>
        </article>
        <article class="view-menubar-card" data-card="dynamic-menubar-card">
          <div class="view-menubar-track">
{% for button in menu_buttons %}
            <button
              class="menubar-item"
              type="button"
              data-action="{{ button.action }}"
              aria-label="{{ button.label }}"
            >
              <span class="menubar-item-label" aria-hidden="true">{{ button.icon }}</span>
              <span class="menubar-item-value">{{ button.label }}</span>
            </button>
{% endfor %}
          </div>
        </article>
      </div>

      <aside class="view-hero-meta" data-card="numeric-data-grid">
{% for item in numeric_data %}
        <div class="view-badge" data-card="numeric-data-card">
          <span class="view-badge-label">{{ item.label }}</span>
          <span class="view-badge-value">{{ item.value }}</span>
        </div>
{% endfor %}
      </aside>
    </section>

    <section class="view-grid">
      <div class="view-column view-column-third">
        <article class="view-panel" data-card="project-information-card">
          <header class="view-panel-head">
            <h2 class="view-panel-title">{{ project.information_title }}</h2>
            <p class="view-panel-copy" id="project-current-date">
              <span class="view-panel-copy-diamond">◆</span>{{ project.generated_fallback_prefix }} {{ generation.date }}.
            </p>
          </header>
          <div class="view-panel-body">
            <dl class="metadata-list">
{% for field in project.fields %}
              <div class="metadata-row">
                <dt>{{ field.label }}</dt>
                <dd>{{ field.value }}</dd>
              </div>
{% endfor %}
            </dl>
          </div>
        </article>
      </div>

      <div class="view-column view-column-main">
        <article class="view-panel project-tabs-card" data-card="project-tabs-card">
          <header class="view-panel-head">
            <h2 class="view-panel-title">{{ tabbed_card.title }}</h2>
            <p class="view-panel-copy">{{ tabbed_card.description }}</p>
          </header>
          <div class="project-tabs-shell">
            <div
              class="project-tabs-nav"
              role="tablist"
              aria-label="{{ tabbed_card.title }}"
              data-project-tablist
            >
{% for tab in tabbed_card.tabs %}
              <button
                class="project-tab"
                type="button"
                id="project-tab-{{ tab.id }}"
                role="tab"
                aria-selected="{{ 'true' if loop.first else 'false' }}"
                aria-controls="project-tab-panel-{{ tab.id }}"
                tabindex="{{ '0' if loop.first else '-1' }}"
                data-tab-id="{{ tab.id }}"
              >
                <span class="project-tab-icon" aria-hidden="true">{{ tab.icon }}</span>
                <span>{{ tab.label }}</span>
              </button>
{% endfor %}
            </div>
            <div class="project-tabs-content">
{% for tab in tabbed_card.tabs %}
              <section
                class="project-tab-panel"
                id="project-tab-panel-{{ tab.id }}"
                role="tabpanel"
                aria-labelledby="project-tab-{{ tab.id }}"
                tabindex="0"
                {% if not loop.first %}hidden{% endif %}
              >
                <div class="project-tab-empty">
                  <span class="project-tab-empty-icon" aria-hidden="true">{{ tab.icon }}</span>
                  <h3>{{ tab.title }}</h3>
                  <p>{{ tab.description }}</p>
                </div>
              </section>
{% endfor %}
            </div>
          </div>
        </article>
      </div>
    </section>

    <footer class="view-panel runtime-footer" data-card="pyodide-runtime-card">
      <header class="view-panel-head">
        <h2 class="view-panel-title">{{ runtime.title }}</h2>
        <p class="view-panel-copy">{{ runtime.description }}</p>
      </header>
      <div class="view-panel-body">
        <div class="runtime-status">
          <span class="runtime-dot" id="pyodide-status-dot"></span>
          <strong id="pyodide-status-label">{{ runtime.initial_status }}</strong>
        </div>
        <pre class="runtime-console" id="pyodide-console">{{ runtime.initial_console }}</pre>
      </div>
    </footer>
  </main>

  <script>
    window.infoBimProjectDashboard = {
      "projectId": {{ project.id | tojson }},
      "name": {{ project.name | tojson }},
      "path": {{ project.path | tojson }}
    };
  </script>
  <script>
    (function () {
      const dateElement = document.getElementById("project-current-date");
      if (!dateElement) {
        return;
      }

      try {
        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const formattedDate = new Intl.DateTimeFormat({{ site.locale | tojson }}, {
          dateStyle: "full",
          timeStyle: "short",
          timeZone,
        }).format(new Date());

        dateElement.innerHTML = "";
        const diamond = document.createElement("span");
        diamond.className = "view-panel-copy-diamond";
        diamond.textContent = "◆";
        dateElement.appendChild(diamond);
        dateElement.appendChild(document.createTextNode(formattedDate));
        if (timeZone) {
          dateElement.title = `Fuso horário: ${timeZone}`;
        }
      } catch (error) {
        console.warn("Não foi possível obter a data local do usuário.", error);
      }
    }());
  </script>
  <script>
    (function () {
      const tabList = document.querySelector("[data-project-tablist]");
      if (!tabList) {
        return;
      }

      const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
      const panels = tabs.map((tab) => {
        const panelId = tab.getAttribute("aria-controls");
        return panelId ? document.getElementById(panelId) : null;
      });

      function activateTab(nextIndex, moveFocus) {
        tabs.forEach((tab, index) => {
          const isActive = index === nextIndex;
          tab.setAttribute("aria-selected", String(isActive));
          tab.setAttribute("tabindex", isActive ? "0" : "-1");
          if (panels[index]) {
            panels[index].hidden = !isActive;
          }
        });

        if (moveFocus && tabs[nextIndex]) {
          tabs[nextIndex].focus();
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activateTab(index, false));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;
          if (event.key === "ArrowRight") {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === "ArrowLeft") {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          } else {
            return;
          }

          event.preventDefault();
          activateTab(nextIndex, true);
        });
      });

      if (tabs.length > 0) {
        activateTab(0, false);
      }
    }());
  </script>
  <script defer src="https://cdn.jsdelivr.net/pyodide/v0.27.2/full/pyodide.js"></script>
  <script defer src="./.__ontobdc__/asset/infobim-view/js/pyodide_bootstrap.js"></script>
</body>
</html>
