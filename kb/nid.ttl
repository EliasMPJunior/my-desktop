:Carta_Precatoria_Eletronica a owl:NamedIndividual,
        foaf:Project,
        schema:SoftwareApplication ;
    dcterms:abstract "Digital case processing product for letters rogatory (TJRJ), covering distribution, execution in the requested court, and return, with digital signature workflows and regulatory compliance rules."@en,
        "Produto de tramitação digital para cartas precatórias (TJRJ), cobrindo distribuição, execução no juízo deprecado e devolução, com regras de assinatura digital e conformidade normativa."@pt-br ;
    foaf:maker :Elias ;
    schema:name "Electronic Letter Rogatory"@en,
        "Carta Precatória Eletrônica"@pt-br ;
    schema:startDate "2010"^^xsd:gYear .

:EDISE a owl:NamedIndividual,
        foaf:Project ;
    dcterms:abstract "BIM work on the electrical systems design for the EDISE Building, including the auditorium and first floor, with Revit modeling, Revit family creation, model review and coordination, interference analysis, and model-delivery preparation using Navisworks and Autodesk Construction Cloud (ACC)."@en,
        "Atuação BIM no projeto de instalações elétricas do Edifício EDISE, incluindo o auditório e o 1º pavimento, com modelagem em Revit, criação de famílias Revit, revisão e compatibilização, análise de interferências e preparação de entregas de modelo com Navisworks e Autodesk Construction Cloud (ACC)."@pt-br ;
    schema:endDate "2023"^^xsd:gYear ;
    schema:name "EDISE Building — Petrobras"@en,
        "Edifício EDISE — Petrobras"@pt-br ;
    schema:startDate "2023"^^xsd:gYear .

:Processo_Decisorio_Digital a owl:NamedIndividual,
        foaf:Project,
        schema:SoftwareApplication ;
    dcterms:abstract "Decision pipeline for investment approvals, centralizing multi-area technical notes, committee approval trails, and final executive decision."@en,
        "Sistema/esteira para decisão de investimentos, centralizando notas técnicas multiárea, trilha de aprovações (comitês) e decisão final da diretoria."@pt-br ;
    foaf:homepage "https://www.youtube.com/watch?v=n-Mp8IAVpDc&t=232s"^^xsd:anyURI ;
    foaf:maker :Elias ;
    schema:endDate "2018"^^xsd:gYear ;
    schema:name "Digital Decision-Making Process (PD)"@en,
        "Processo Decisório Digital (PD)"@pt-br ;
    schema:startDate "2017"^^xsd:gYear .

:bim_coordinator_profile a bdc_role:BIMCoordinatorProfile,
        cv:CV,
        owl:NamedIndividual ;
    bdc_role:hasAchievement :Achievement_ERA_BIM_IFC5_Workshop,
        :Achievement_OilGas,
        :Achievement_bSI_Assembly,
        :Achievement_bSI_Hackathon ;
    bdc_role:hasSkillGroup :Automation_Skills,
        :BIM_Skills,
        :Data_Cloud_Skills ;
    cv:hasCourse :bSI_Certification ;
    cv:hasEducation :Civil_Engerineering,
        :Information_Technology ;
    cv:hasWorkHistory :Work_Brasidata,
        :Work_CERTI,
        :Work_Concat,
        :Work_InfraCidades,
        :Work_ReforceSul,
        :Work_Tecgraf,
        :Work_Zigurat ;
    cv:targetJobDescription "Specialist in BIM project coordination, focused on multidisciplinary integration, clash detection, and information quality assurance (QA/QC). Experienced in managing Common Data Environments (CDE) and driving OpenBIM workflows to ensure efficiency and compliance with industry standards."@en,
        "Especialista em coordenação de projetos BIM, focado na integração de disciplinas, detecção de conflitos (Clash Detection) e garantia de qualidade da informação (QA/QC). Experiência na gestão de Ambientes Comuns de Dados (CDE) e na condução de fluxos de trabalho OpenBIM para garantir a eficiência e a conformidade com as normas do setor."@pt-br ;
    cv:targetJobTitle "BIM Coordinator"@en,
        "Coordenador BIM"@pt-br .

:bim_researcher_profile a bdc_role:BIMResearcherProfile,
        cv:CV,
        owl:NamedIndividual ;
    bdc_role:hasAchievement :Achievement_ERA_BIM_IFC5_Workshop,
        :Achievement_OilGas,
        :Achievement_bSI_Assembly,
        :Achievement_bSI_Hackathon ;
    bdc_role:hasSkillGroup :Automation_Skills,
        :BIM_Skills,
        :Data_Cloud_Skills ;
    cv:hasCourse :bSI_Certification ;
    cv:hasEducation :Civil_Engerineering,
        :Information_Technology ;
    cv:hasWorkHistory :Work_Brasidata,
        :Work_CERTI,
        :Work_Concat,
        :Work_InfraCidades,
        :Work_ReforceSul,
        :Work_Tecgraf,
        :Work_Zigurat ;
    cv:targetJobDescription "BIM research engineer who treats BIM as data infrastructure, not as drawings or useless 3D mockups. Specialist in interoperability, IFC, ontologies, model auditing, automation, and the development of information management systems for the construction industry. I combine applied research, engineering, and software development to create robust solutions for data governance, integration, and scalability across the AECO ecosystem."@en,
        "Engenheiro pesquisador em BIM que trabalha o BIM como infraestrutura de dados, e não com desenhos ou maquetes. Especialista em interoperabilidade, IFC, ontologias, auditoria de modelos, automação e desenvolvimento de sistemas para gestão da informação na construção civil. Uno pesquisa aplicada, engenharia e desenvolvimento de software para criar soluções robustas de governança, integração e escalabilidade de dados no ecossistema AECOO."@pt-br ;
    cv:targetJobTitle "BIM Research Engineer"@en,
        "Engenheiro Pesquisador BIM"@pt-br .

:bim_tech_lead_profile a bdc_role:BIMTechLeadProfile,
        cv:CV,
        owl:NamedIndividual ;
    bdc_role:hasAchievement :Achievement_ERA_BIM_IFC5_Workshop,
        :Achievement_OilGas,
        :Achievement_bSI_Assembly,
        :Achievement_bSI_Hackathon ;
    bdc_role:hasSkillGroup :Automation_Skills,
        :BIM_Skills,
        :Data_Cloud_Skills ;
    cv:hasCourse :bSI_Certification ;
    cv:hasEducation :Civil_Engerineering,
        :Information_Technology ;
    cv:hasWorkHistory :Work_Brasidata,
        :Work_CERTI,
        :Work_Concat,
        :Work_InfraCidades,
        :Work_ReforceSul,
        :Work_Tecgraf,
        :Work_Zigurat ;
    cv:targetJobDescription "Technical leader specialized in the development and architecture of BIM solutions, Semantic Web, and engineering automation. Focused on creating tools, APIs, and integrations for AECO data scalability, leading development teams to transform complex requirements into efficient data infrastructure."@en,
        "Líder técnico especializado no desenvolvimento e arquitetura de soluções BIM, Web Semântica e automação de engenharia. Focado na criação de ferramentas, APIs e integrações para escalabilidade de dados AECO, liderando equipes de desenvolvimento para transformar requisitos complexos em infraestrutura de dados eficiente."@pt-br ;
    cv:targetJobTitle "BIM Tech Lead"@en,
        "Líder Técnico BIM"@pt-br .

