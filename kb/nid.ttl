schema:Group a owl:Class .

:InfoBIM a owl:NamedIndividual,
        foaf:Project,
        schema:SoftwareSourceCode ;
    dcterms:abstract "A modular runtime environment for Engineering Automation that bridges the gap between static BIM data and dynamic AI agents. InfoBIM provides a machine-readable catalog of tools via its Discovery Protocol, turning ad-hoc OpenBIM scripts into a repeatable production line of capabilities. It enables LLMs to orchestrate automated logic checking, IDS-native rules, and descriptive report generation directly from IFC models, acting as the capability engine for BIM automation."@en,
        "Um ambiente de execução modular para Automação de Engenharia que preenche a lacuna entre dados BIM estáticos e agentes de IA dinâmicos. O InfoBIM fornece um catálogo de ferramentas legível por máquina através de seu Protocolo de Descoberta, transformando scripts OpenBIM avulsos em uma linha de produção de capacidades reutilizáveis. Ele permite que LLMs orquestrem checagens lógicas automatizadas, regras nativas IDS e geração de relatórios descritivos diretamente de modelos IFC, atuando como o motor de capacidades para a automação BIM."@pt-br ;
    foaf:homepage "https://infobim.org"^^xsd:anyURI ;
    foaf:maker :Elias ;
    schema:license "Open Source" ;
    schema:name "InfoBIM Framework" ;
    schema:programmingLanguage "Python" .

:OntoBDC a owl:NamedIndividual,
        foaf:Project,
        schema:SoftwareSourceCode ;
    dcterms:abstract "OntoBDC is a Semantic Workflow Execution Framework designed to build and extend enterprise knowledge graphs, addressing the interoperability challenge across highly heterogeneous data sources (such as BIM, IoT, CSV, and ERPs). Instead of relying on traditional ETL conversions and centralized silos, the architecture applies advanced Semantic Web principles and W3C standards to \"decentralize data and centralize meaning\". By using semantic URIs, linksets, and RDF federation, the system maps relationships and integrates data in real time under a shared ontology (such as schema.org), creating a data mesh ready to support structured validation and scalable business logic. By leading this project (applied to European regulatory traceability via Digital Product Passports with legal validity using ASiC), I demonstrate deep capability in ontology engineering, decentralized data governance, and practical application of RDF/W3C standards."@en,
        "O OntoBDC é um Framework de Execução de Workflow Semântico desenvolvido para construir e estender grafos de conhecimento corporativos (Enterprise Knowledge Graphs), resolvendo o complexo desafio de interoperabilidade entre fontes de dados altamente heterogêneas (como BIM, IoT, CSV e ERPs). Em vez de depender de processos tradicionais de conversão de dados (ETL) e silos centralizados, a arquitetura utiliza princípios avançados da Web Semântica e padrões da W3C para \"descentralizar o dado e centralizar o significado\". Através do uso de URIs semânticas, Linksets e federação em RDF, o sistema mapeia relacionamentos e integra dados em tempo real sob uma ontologia comum (como o schema.org), criando uma malha de dados (Data Mesh) pronta para suportar validações estruturadas e lógicas complexas de negócios de forma escalável. Ao liderar este projeto (aplicado à rastreabilidade regulatória europeia via Digital Product Passports com validade jurídica ASiC), demonstro profunda capacidade em engenharia de ontologias, governança de dados descentralizados e aplicação prática de padrões RDF/W3C."@pt-br ;
    foaf:homepage "https://ontobdc.org"^^xsd:anyURI ;
    foaf:maker :Elias ;
    schema:license "Open Source" ;
    schema:name "OntoBDC Framework" ;
    schema:programmingLanguage "Python" .

schema:SoftwareSourceCode a owl:Class .

bdc_org:Brasidata a owl:NamedIndividual ;
    schema:name "Brasidata" .

:Achievement_ERA_BIM_IFC5_Workshop a owl:NamedIndividual ;
    schema:description "Presented insights on the new IFC5 openBIM standard in a dedicated workshop at the A ERA BIM Congress, focusing on digital ecosystems, data-driven workflows, and interoperability across the AECO industry. The event took place in São Paulo (Centro de Convenções Frei Caneca)."@en,
        "Palestra e workshop dedicados ao novo padrão openBIM IFC5 no congresso A ERA BIM, com foco em ecossistemas digitais, fluxos orientados a dados e interoperabilidade na indústria AECO. Evento realizado em São Paulo (Centro de Convenções Frei Caneca)."@pt-br .

:Achievement_OilGas a owl:NamedIndividual ;
    schema:description "Advanced experience in modeling and coordinating complex facility projects focused on the Oil & Gas sector."@en,
        "Experiência avançada em modelagem e coordenação de projetos de instalações complexas focadas no setor de Óleo & Gás."@pt-br .

:Achievement_bSI_Assembly a owl:NamedIndividual ;
    schema:description "Active participation in the last 4 buildingSMART Implementers Assemblies, exclusive global technical meetings for software vendors to discuss the implementation of openBIM standards and IFC5 services."@en,
        "Participação ativa nas últimas 4 edições da buildingSMART Implementers Assembly, reuniões técnicas globais exclusivas para desenvolvedores de software discutirem a implementação de padrões openBIM e serviços IFC5."@pt-br .

:Achievement_bSI_Hackathon a owl:NamedIndividual ;
    schema:description "Participation in the buildingSMART Hackathon in Porto (2026), developing an automated workflow that integrates PDF requirement extraction via LLMs, Turtle ontologies, and IFC models to generate formal verification artifacts (IDS/IDCS) and automated compliance reports using tools such as IfcOpenShell, SymPy, and ifctester."@en,
        "Participação no Hackathon da buildingSMART no Porto (2026), desenvolvendo um fluxo de trabalho automatizado que integra extração de requisitos em PDF via LLMs, ontologias Turtle e arquivos IFC para a geração de artefatos de verificação formal (IDS/IDCS) e relatórios automatizados de conformidade utilizando ferramentas como IfcOpenShell, SymPy e ifctester."@pt-br .

