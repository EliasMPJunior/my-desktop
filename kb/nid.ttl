:Work_InfraCidades a cv:WorkHistory,
        owl:NamedIndividual ;
    cv:employedIn bdc_org:InfraCidades ;
    cv:endDate "2023-12-01" ;
    cv:jobDescription "Delivered hands-on BIM training to public sector professionals across Brazil. Structured pilot projects using Revit, BlenderBIM, Dynamo, IfcOpenShell, and VS Code. Taught parametric modeling, audit-ready data structuring, and automation scripts. Enabled teams to implement CDE concepts and IFC export processes aligned with open standards."@en,
        "Ministrou treinamento BIM prático para profissionais do setor público em todo o Brasil. Estruturou projetos piloto usando Revit, BlenderBIM, Dynamo, IfcOpenShell e VS Code. Ensinou modelagem paramétrica, estruturação de dados para auditoria e scripts de automação. Capacitou equipes para implementar conceitos de CDE e processos de exportação IFC alinhados com padrões abertos."@pt-br ;
    cv:jobTitle "BIM Trainer - AEC Digital Transformation"@en,
        "Instrutor BIM - Transformação Digital AEC"@pt-br ;
    cv:startDate "2022-01-01" .

:Work_ReforceSul a cv:WorkHistory,
        owl:NamedIndividual ;
    cv:employedIn bdc_org:ReforceSul ;
    cv:endDate "2016-12-01" ;
    cv:jobDescription "Automated budgeting and simulation models for marina reinforcement works. Designed execution schedule aligned with tidal windows using Python scripting and Excel automation."@en,
        "Automatizou modelos de orçamento e simulação para obras de reforço de marinas. Projetou cronograma de execução alinhado com janelas de maré usando scripts em Python e automação no Excel."@pt-br ;
    cv:jobTitle "Technical Consultant - Coastal Works"@en,
        "Consultor Técnico - Obras Costeiras"@pt-br ;
    cv:startDate "2015-01-01" .

:Work_TJRJ_Oracle_DBA a cv:WorkHistory,
        owl:NamedIndividual ;
    cv:employedIn bdc_org:TJRJ ;
    cv:endDate "2008-12-01" ;
    cv:jobDescription "Worked as an Oracle DBA at the Court of Justice of Rio de Janeiro (TJRJ), focused on database administration, reliability, and operational discipline."@en,
        "Atuação como DBA Oracle no Tribunal de Justiça do Estado do Rio de Janeiro (TJRJ), com foco em administração de banco de dados, confiabilidade e disciplina operacional."@pt-br ;
    cv:jobTitle "Oracle DBA"@en,
        "DBA Oracle"@pt-br ;
    cv:startDate "2006-01-01" .

:Work_Tecgraf a cv:WorkHistory,
        owl:NamedIndividual ;
    cv:employedIn bdc_org:PUC_Rio ;
    cv:endDate "2018-12-01" ;
    cv:jobDescription "Investigated BIM application to historic building documentation. Built custom IFC-to-JSON parsers for spatial indexing and semantic labeling. Integrated MongoDB with non-structured heritage data for visual exploration."@en,
        "Investigou aplicação de BIM para documentação de edifícios históricos. Construiu parsers customizados IFC-to-JSON para indexação espacial e rotulagem semântica. Integrou MongoDB com dados não estruturados de patrimônio para exploração visual."@pt-br ;
    cv:jobTitle "Researcher - BIM for Heritage Projects"@en,
        "Pesquisador - BIM para Patrimônio Histórico"@pt-br ;
    cv:startDate "2017-01-01" .

